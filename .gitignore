.DS_Store
node_modules/
*.log

# Personal, machine-local work: song exports (.oscine.json), local config,
# and sketches you are experimenting with. Everything under local/ is ignored
# except its README, so your work there never shows up as something to commit.
/local/*
!/local/README.md
src/engine/instruments/gbdata.game.js
plugin/app/src/engine/instruments/gbdata.game.js
scripts/local/
src/engine/instruments/breakdata.local.js
plugin/app/src/engine/instruments/breakdata.local.js
